PORT=5000

# ========================================
# MONGODB ATLAS - Thay connection string của bạn vào đây
# ========================================
# Format: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ai-account-store
# Ví dụ: mongodb+srv://aistore:MyPassword123@cluster0.abc123.mongodb.net/ai-account-store
MONGODB_URI=mongodb+srv://AiStore2024:MyPassword123@cluster0.ofbeiba.mongodb.net/ai-account-store?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=your-super-secret-jwt-key-change-this

# ========================================
# ENCRYPTION KEY - Mã hóa thông tin tài khoản
# ========================================
# BẮT BUỘC: Key phải có ít nhất 32 ký tự
ENCRYPTION_KEY=ai-store-encryption-key-32chars!

# ========================================
# SEPAY WEBHOOK SECURITY
# ========================================
# Lấy API Key từ: https://my.sepay.vn -> Cài đặt -> API
# Để trống = tắt verification (chỉ dùng cho development)
SEPAY_API_KEY=

# Thông tin thanh toán VietQR
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=NGUYEN VAN A
