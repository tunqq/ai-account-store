# ========================================
# AI STORE - BACKEND CONFIGURATION
# ========================================
# Copy file này thành .env và chỉnh sửa theo nhu cầu

# ========================================
# SERVER
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# DATABASE - MongoDB
# ========================================
# Local: mongodb://localhost:27017/ai-account-store
# Atlas: mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/ai-account-store
MONGODB_URI=mongodb://localhost:27017/ai-account-store

# ========================================
# AUTHENTICATION
# ========================================
# JWT Secret - BẮT BUỘC thay đổi trong production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ========================================
# ADMIN ACCOUNT (Dùng cho seed.js)
# ========================================
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@aistore.vn
ADMIN_PASSWORD=admin123

# ========================================
# TEST USER (Dùng cho seed.js)
# ========================================
TEST_USER_NAME=Test User
TEST_USER_EMAIL=user@test.com
TEST_USER_PASSWORD=user123

# ========================================
# THANH TOÁN - VietQR
# ========================================
# Danh sách mã ngân hàng:
# 970422 - MB Bank
# 970415 - VietinBank  
# 970436 - Vietcombank
# 970418 - BIDV
# 970407 - Techcombank
# 970423 - TPBank
# 970432 - VPBank
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=AI STORE

# ========================================
# SEPAY - Tự động xác nhận thanh toán
# ========================================
# Đăng ký tại: https://my.sepay.vn
# Webhook URL: https://your-domain.com/api/orders/webhook/sepay
# 
# Cách cấu hình:
# 1. Đăng nhập Sepay -> Cài đặt -> Webhook
# 2. Thêm webhook URL: https://your-domain.com/api/orders/webhook/sepay
# 3. Chọn sự kiện: Giao dịch mới
# 4. Lưu và test webhook
#
# Lưu ý: Số tài khoản ngân hàng phải được liên kết với Sepay

# ========================================
# ENCRYPTION - Mã hóa thông tin tài khoản
# ========================================
# BẮT BUỘC: Key phải có ít nhất 32 ký tự
# Tạo key ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-super-secret-32-character-key-change-this

# ========================================
# SEPAY WEBHOOK SECURITY
# ========================================
# Lấy API Key từ: https://my.sepay.vn -> Cài đặt -> API
# Webhook sẽ gửi key này trong header Authorization
# Để trống = tắt verification (KHÔNG KHUYẾN KHÍCH cho production!)
SEPAY_API_KEY=your-sepay-api-key-here

# ========================================
# CORS
# ========================================
FRONTEND_URL=http://localhost:3000

# ========================================
# STORE INFO
# ========================================
STORE_NAME=AI Store
STORE_EMAIL=support@aistore.vn
STORE_PHONE=0123456789
